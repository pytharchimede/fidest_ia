APP_NAME="FIDEST IA"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/fidest_ia

AUTO_BOOTSTRAP=true
AUTO_MIGRATE=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fidestci_ia_db
DB_USERNAME=fidestci_ulrich
DB_PASSWORD=
DB_CHARSET=utf8mb4

OCR_DRIVER=tesseract
OCR_BINARY=tesseract
OCR_LANGUAGES=fra+eng

DOCUMENTS_PATH=storage/documents
MAX_UPLOAD_MB=15

API_ENABLED=true
API_ALLOWED_ORIGINS=http://localhost,http://localhost/fidest_ia

# Clé maître permettant de se connecter à /admin.
# Générer une valeur forte et ne jamais la committer.
ADMIN_TOKEN=

# Facultatif : accès API maître de secours.
# Les applications normales (FINEA, IFMAP, LBP...) doivent utiliser
# leurs propres clés fia_live_* générées depuis /admin.
API_BEARER_TOKEN=

# Limite par défaut lors de la création d'une application API.
API_RATE_LIMIT_PER_MINUTE=60

APP_NAME="FIDEST IA"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/fidest_ia

AUTO_BOOTSTRAP=true
AUTO_MIGRATE=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fidestci_ia_db
DB_USERNAME=fidestci_ulrich
DB_PASSWORD=
DB_CHARSET=utf8mb4

OCR_DRIVER=auto
OCR_BINARY=tesseract
OCR_EMBEDDED_BINARY=/home/fidestci/ia.fidest.ci/tools/tesseract/squashfs-root/AppRun
OCR_LANGUAGES=fra+eng
OCR_TIMEOUT_SECONDS=120

# Optimisation des documents avant OCR.
# Activer le mode mutualisé lorsque Tesseract dispose de peu de RAM/CPU.
OCR_OPTIMIZE_DOCUMENTS=true
OCR_SHARED_HOSTING_MODE=false
OCR_MAX_IMAGE_WIDTH=1400
OCR_OMP_THREAD_LIMIT=1
OCR_LOCK_FILE=/home/fidestci/ia.fidest.ci/storage/locks/ocr.lock
OCR_LOCK_WAIT_SECONDS=2

# Protection globale des ressources serveur avant tout traitement lourd.
# En mutualisé, laisser activé pour éviter qu'un OCR ne pénalise les autres applications.
SERVER_RESOURCE_GUARD=true
SERVER_MAX_LOAD_PER_CPU=1.20
SERVER_MAX_MEMORY_PERCENT=85
SERVER_RESOURCE_RETRY_AFTER=15

PDF_CONVERTER=auto
PDF_POPPLER_BINARY=pdftoppm
PDF_GS_BINARY=/bin/gs
PDF_IMAGEMAGICK_BINARY=/bin/convert
PDF_DPI=150
PDF_SHARED_HOSTING_DPI=100
PDF_MAX_PAGES=20

DOCUMENTS_PATH=storage/documents
MAX_UPLOAD_MB=15

API_ENABLED=true
API_ALLOWED_ORIGINS=http://localhost,http://localhost/fidest_ia

ADMIN_TOKEN=
API_BEARER_TOKEN=
API_RATE_LIMIT_PER_MINUTE=60

AI_ENABLED=false

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application internals or secret/config files.
    RewriteRule ^(?:app|config|database|storage|tests|vendor|scripts|src|data|feb|docs)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|README(?:_PROTOTYPE)?\.md)$ - [F,L,NC]

    # Professional versioned API routes.
    RewriteRule ^api/v1/(.*)$ public/api/v1/index.php?_route=$1 [L,QSA]

    # Legacy API kept temporarily for backward compatibility.
    RewriteRule ^api/(.*)$ public/api/$1 [L,QSA]
</IfModule>
